  "scripts": {
    "nx": "nx",
    "graph": "nx graph",
    "dev": "nx dev web-manager",
    "dev:web-manager": "nx dev web-manager",
    "dev:api-server": "nx serve api-server",
    "dev:stack": "node tools/run-web-manager-https-stack.js",
    "dev:electron": "nx run desktop:serve",
    "e2e": "npm run e2e:web",
    "e2e:web": "npm run e2e:seed:web && npx playwright test --config=e2e/web/playwright.config.js",
    "e2e:web:ui": "npx playwright test --config=e2e/web/playwright.config.js --ui",
    "e2e:web:report": "npx playwright show-report e2e/artifacts/web-report",
    "e2e:seed:web": "node e2e/shared/seed-web.js",
    "e2e:prepare:electron": "nx run desktop:build && nx build api-server && nx run web-manager:build-electron",
    "e2e:shared:electron": "npm run e2e:prepare:electron && npx playwright test --config=e2e/electron/shared.playwright.config.js",
    "e2e:electron:platform": "npm run e2e:prepare:electron && npx playwright test --config=e2e/electron/platform.playwright.config.js",
    "e2e:electron:packaged": "npm run package:electron && npx playwright test --config=e2e/electron/packaged.playwright.config.js",
    "e2e:electron": "npm run e2e:prepare:electron && npx playwright test --config=e2e/electron/playwright.config.js",
    "e2e:electron:ui": "npm run e2e:prepare:electron && npx playwright test --config=e2e/electron/playwright.config.js --ui",
    "e2e:clean": "rm -rf e2e/artifacts/web-results e2e/artifacts/web-report e2e/artifacts/electron-results e2e/artifacts/packaged-electron-results",
    "e2e:clean:vps": "node tools/clean-vps.js",
    "e2e:real-cms": "npm run e2e:web && npm run e2e:electron",
    "e2e:all": "npm run e2e:real-cms",
    "e2e:full": "npm run e2e:clean && npm run e2e:clean:vps && npm run e2e:web && npm run e2e:electron",
    "e2e:report": "npx playwright show-report e2e/artifacts/web-report",
    "e2e:report:save": "node tools/save-report.js",
    "e2e:check": "npx playwright test --config=e2e/web/playwright.config.js --list && npx playwright test --config=e2e/electron/playwright.config.js --list && npx playwright test --config=e2e/electron/packaged.playwright.config.js --list",
    "build:web-manager": "nx build web-manager",
    "build:api-server": "nx build api-server",
    "build:server": "npm run build:web-manager && npm run build:api-server && node scripts/copy-web-to-api.mjs",
    "build": "nx run-many -t build --all",
    "start": "node dist/apps/api-server/main.js",
    "package:server": "npm run build:web-manager && nx run api-server:build:exe:all && node scripts/assemble-package.mjs all",
    "package:server:linux": "npm run build:web-manager && nx run api-server:build:exe:linux && node scripts/assemble-package.mjs linux",
    "package:server:win": "npm run build:web-manager && nx run api-server:build:exe:windows && node scripts/assemble-package.mjs win",
    "package:server:mac": "npm run build:web-manager && nx run api-server:build:exe:macos && node scripts/assemble-package.mjs mac",
    "package:electron": "node scripts/sync-version.mjs && nx run desktop:package",
    "package:electron:mac": "node scripts/sync-version.mjs && nx run desktop:package -- --mac",
    "package:electron:win": "node scripts/sync-version.mjs && nx run desktop:package -- --win",
    "package:electron:linux": "node scripts/sync-version.mjs && nx run desktop:package -- --linux",
    "lint": "nx run-many -t lint --all",
    "lint:web-manager": "nx lint web-manager",
    "lint:api-server": "nx lint api-server",
    "test": "nx run-many -t test --all",
    "test:web-manager": "nx test web-manager",
    "test:api-server": "nx test api-server",
    "typecheck:api-server": "npx tsc -p apps/api-server/tsconfig.app.json --noEmit",
    "ci": "npm run typecheck:api-server && npm run build",
    "ssl:local-prod": "bash scripts/generate-local-production-ssl.sh",
    "migrate-storage-master-key": "node scripts/migrate-storage-master-key.mjs",
    "preview:web-manager": "nx preview web-manager",
    "serve:web-manager:dist": "node tools/serve-web-manager.js",
    "pkg:api-server": "nx run api-server:build:exe",
    "pkg:api-server:linux": "nx run api-server:build:exe:linux",
    "pkg:api-server:windows": "nx run api-server:build:exe:windows",
    "pkg:api-server:macos": "nx run api-server:build:exe:macos",
    "pkg:api-server:all": "nx run api-server:build:exe:all",
    "serve:web-manager:dist:4200": "node tools/serve-web-manager.js 4200",
    "serve:web-manager:dist:8080": "node tools/serve-web-manager.js 8080"
  },
  "pkg": {
    "scripts": [
      "main.js"
    ],
    "assets": [
      "assets/**/*",
      "node_modules/axios/**/*",
      "node_modules/@nestjs/axios/**/*",
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64",
      "node18-macos-x64"
    ],
    "outputPath": "dist/executables"
  }
}
