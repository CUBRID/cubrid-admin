{
  "name": "api-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api-server/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/api-server"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/api-server/package.json",
        "{workspaceRoot}/dist/apps/api-server/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api-server/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/apps/api-server/main.js",
        "cwd": "{workspaceRoot}",
        "env": { "ENVIRONMENT": "development" }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "build:exe": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": ["node scripts/copy-web-to-api.mjs", "node scripts/build-server-sea.mjs"],
        "parallel": false
      },
      "configurations": {
        "windows": {
          "commands": ["node scripts/copy-web-to-api.mjs", "node scripts/build-server-sea.mjs --target windows-x64"],
          "parallel": false
        },
        "linux": {
          "commands": [
            "node scripts/copy-web-to-api.mjs",
            "node scripts/build-server-sea.mjs --target linux-x64 --target linux-x64-el7 --target linux-arm64"
          ],
          "parallel": false
        },
        "macos": {
          "commands": ["node scripts/copy-web-to-api.mjs", "node scripts/build-server-sea.mjs --target macos-x64 --target macos-arm64"],
          "parallel": false
        },
        "all": {
          "commands": ["node scripts/copy-web-to-api.mjs", "node scripts/build-server-sea.mjs"],
          "parallel": false
        }
      }
    }
  }
}
