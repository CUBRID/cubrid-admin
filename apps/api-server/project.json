{
  "name": "api-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api-server/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/api-server"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/api-server/package.json",
        "{workspaceRoot}/dist/apps/api-server/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api-server/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/apps/api-server/main.js",
        "cwd": "{workspaceRoot}",
        "env": { "ENVIRONMENT": "development" }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "build:exe": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "cd dist/apps/api-server && npm install --production",
          "node apps/api-server/scripts/prepare-pkg-manifest.js",
          "node scripts/copy-web-to-api.mjs",
          "npx pkg dist/apps/api-server/package.json"
        ],
        "parallel": false
      },
      "configurations": {
        "windows": {
          "commands": [
            "cd dist/apps/api-server && npm install --production",
            "node apps/api-server/scripts/prepare-pkg-manifest.js --target node18-win-x64",
            "node scripts/copy-web-to-api.mjs",
            "npx pkg dist/apps/api-server/package.json --targets node18-win-x64 --output dist/executables/cubrid-web-manager.exe"
          ],
          "parallel": false
        },
        "linux": {
          "commands": [
            "cd dist/apps/api-server && npm install --production",
            "node apps/api-server/scripts/prepare-pkg-manifest.js --target node18-linux-x64",
            "node scripts/copy-web-to-api.mjs",
            "npx pkg dist/apps/api-server/package.json --targets node18-linux-x64 --output dist/executables/cubrid-web-manager-linux"
          ],
          "parallel": false
        },
        "macos": {
          "commands": [
            "cd dist/apps/api-server && npm install --production",
            "node apps/api-server/scripts/prepare-pkg-manifest.js --target node18-macos-x64",
            "node scripts/copy-web-to-api.mjs",
            "npx pkg dist/apps/api-server/package.json --targets node18-macos-x64 --output dist/executables/cubrid-web-manager-macos"
          ],
          "parallel": false
        },
        "all": {
          "commands": [
            "cd dist/apps/api-server && npm install --production",
            "node scripts/copy-web-to-api.mjs",
            "node apps/api-server/scripts/prepare-pkg-manifest.js --target node18-win-x64",
            "npx pkg dist/apps/api-server/package.json --targets node18-win-x64 --output dist/executables/cubrid-web-manager.exe",
            "node apps/api-server/scripts/prepare-pkg-manifest.js --target node18-linux-x64",
            "npx pkg dist/apps/api-server/package.json --targets node18-linux-x64 --output dist/executables/cubrid-web-manager-linux",
            "node apps/api-server/scripts/prepare-pkg-manifest.js --target node18-macos-x64",
            "npx pkg dist/apps/api-server/package.json --targets node18-macos-x64 --output dist/executables/cubrid-web-manager-macos"
          ],
          "parallel": false
        }
      }
    }
  }
}
